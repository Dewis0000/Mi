      "event.conflict_hostilities_resume.body": "The ceasefire collapses and the fighting starts again. Plans made during the lull have to be set aside.",
      "event.conflict_veteran_reintegration.title": "Returning to civilian life",
      "event.conflict_veteran_reintegration.body": "After service in the combat zone, adjusting to civilian life takes longer than expected. Old acquaintances and work look different now.",
      "event.conflict_veteran_benefits.choice.pursue_benefits.label": "Pursue the benefits",
      "event.conflict_veteran_benefits.choice.forgo_benefits.label": "Forgo the process",
      "event.conflict_veteran_benefits.title": "Applying for veteran benefits",
      "event.conflict_veteran_benefits.body": "The benefits and payments a veteran is legally entitled to require working through a long bureaucratic process.",
      "event.conflict_elder_mediation.title": "Mediation by community elders",
      "event.conflict_elder_mediation.body": "Community elders step in to mediate between the sides of a local dispute. Their effort eases the tension for a while.",
      "event.conflict_sectarian_daily_tension.title": "Tension along communal lines",
      "event.conflict_sectarian_daily_tension.body": "Division along religious or ethnic lines is felt in everyday dealings — at the market, in lines, at work.",
      "event.conflict_landmine_contaminated_land.choice.request_demining.label": "Request demining of the land",
      "event.conflict_landmine_contaminated_land.choice.avoid_contaminated_land.label": "Simply avoid the contaminated area",
      "event.conflict_landmine_contaminated_land.title": "Mine-contaminated land",
      "event.conflict_landmine_contaminated_land.body": "Part of the farmland is closed off because of unexploded mines. The amount of land safely available for farming has shrunk.",
      "event.conflict_siege_blockade.title": "Blockade and shortages",
      "event.conflict_siege_blockade.body": "Roads into the region are blocked and supply shipments nearly stop. Prices jump sharply, and some goods simply disappear.",
      "event.conflict_organized_evacuation.choice.join_evacuation.label": "Join the evacuation",
      "event.conflict_organized_evacuation.choice.remain.label": "Remain behind",
      "event.conflict_organized_evacuation.title": "An organized evacuation",
      "event.conflict_organized_evacuation.body": "Authorities or aid organizations offer an organized evacuation out of the conflict zone. The decision has to be made quickly.",
      "event.conflict_returning_to_destroyed_home.title": "Returning to a destroyed home",
      "event.conflict_returning_to_destroyed_home.body": "When the fighting dies down, the family returns to find the home destroyed or occupied. Rebuilding starts almost from nothing.",
      "event.conflict_community_solidarity_rebuilding.title": "The community rebuilds together",
      "event.conflict_community_solidarity_rebuilding.body": "Once active fighting ends, neighbors rebuild damaged homes and public buildings together. The shared work strengthens ties between people.",
      "event.conflict_informant_suspicion.choice.defend_reputation.label": "Defend your reputation",
