      "event.conflict_curfew_restrictions.title": "Curfew restrictions",
      "event.conflict_curfew_restrictions.body": "Authorities impose a curfew. Movement around town is restricted, and work and school have to fit around it.",
      "event.conflict_fleeing_violence.choice.flee_to_another_region.label": "Flee to another region or country",
      "event.conflict_fleeing_violence.choice.shelter_in_place.label": "Shelter in a basement or bunker",
      "event.conflict_fleeing_violence.choice.flee_to_relatives_nearby.label": "Wait it out with relatives nearby",
      "event.conflict_fleeing_violence.title": "Fleeing the fighting",
      "event.conflict_fleeing_violence.body": "The fighting draws too close to home. The family has to decide what to do right now.",
      "event.conflict_draft_notice.choice.report_for_duty.label": "Report for duty",
      "event.conflict_draft_notice.choice.evade_draft.label": "Evade the draft",
      "event.conflict_draft_notice.title": "A draft notice",
      "event.conflict_draft_notice.body": "A draft notice arrives, calling you up for military service. The response to it shapes the years that follow.",
      "event.conflict_exemption_negotiation.choice.pursue_exemption.label": "Pursue the exemption",
      "event.conflict_exemption_negotiation.choice.accept_conscription.label": "Accept conscription as it stands",
      "event.conflict_exemption_negotiation.choice.evade_quietly.label": "Evade quietly",
      "event.conflict_exemption_negotiation.title": "Seeking an exemption",
      "event.conflict_exemption_negotiation.body": "Before the draft, there is a chance to seek a lawful exemption — on medical grounds, for study, or because of family hardship.",
      "event.conflict_service_continuation.choice.routine_service.label": "Continue in routine service",
      "event.conflict_service_continuation.choice.combat_deployment.label": "Deploy to the combat zone",
      "event.conflict_service_continuation.choice.discharge.label": "Be discharged",
      "event.conflict_service_continuation.title": "Continuing military service",
      "event.conflict_service_continuation.body": "The term of service reaches a turning point. The decision determines whether it stays routine, turns into active combat duty, or ends in discharge.",
      "event.conflict_checkpoint_harassment.title": "A checkpoint stop",
      "event.conflict_checkpoint_harassment.body": "A trip through a checkpoint turns into a long check of documents and belongings. The delay has become part of daily life.",
      "event.conflict_property_destruction.choice.rebuild_property.label": "Rebuild what was destroyed",
      "event.conflict_property_destruction.choice.leave_it_in_ruins.label": "Leave it in ruins for now",
      "event.conflict_property_destruction.title": "Property destroyed in the fighting",
      "event.conflict_property_destruction.body": "The home or farm buildings are damaged in the fighting. Rebuilding takes money that is now in short supply.",
      "event.conflict_livelihood_disruption.choice.seek_alternative_income.label": "Seek an alternative income source",
      "event.conflict_livelihood_disruption.choice.wait_for_stability.label": "Wait for things to stabilize",
      "event.conflict_livelihood_disruption.title": "Livelihood disrupted by instability",
      "event.conflict_livelihood_disruption.body": "Instability in the region forces a business to close or work to stop for an indefinite stretch.",
      "event.conflict_civilian_relief_volunteering.choice.volunteer.label": "Volunteer",
      "event.conflict_civilian_relief_volunteering.choice.decline_volunteering.label": "Decline",
      "event.conflict_civilian_relief_volunteering.title": "Volunteering for relief work",
      "event.conflict_civilian_relief_volunteering.body": "A humanitarian organization is looking for volunteers to work with people affected by the conflict. Taking part costs time and carries some risk.",
      "event.conflict_armed_group_pressure.choice.refuse_join.label": "Refuse",
      "event.conflict_armed_group_pressure.choice.comply_reluctantly.label": "Comply reluctantly",
      "event.conflict_armed_group_pressure.choice.flee_the_area.label": "Leave the area",
      "event.conflict_armed_group_pressure.title": "Pressure to join an armed group",
      "event.conflict_armed_group_pressure.body": "A local armed group pressures you to join its ranks, offering protection and income. Refusal may be noticed and carry its own consequences.",
      "event.conflict_relative_conscripted_elsewhere.title": "A relative is drafted elsewhere",
      "event.conflict_relative_conscripted_elsewhere.body": "A close relative is called up for service far from home. Worry for them and the economic strain on the family rise together.",
      "event.conflict_refugee_camp_conditions.title": "Conditions in the temporary camp",
      "event.conflict_refugee_camp_conditions.body": "Before resettling permanently, the family lives in a temporary camp for displaced people. Conditions are modest but safer than back home.",
      "event.conflict_safe_passage_negotiation.choice.attempt_crossing.label": "Risk the crossing",
      "event.conflict_safe_passage_negotiation.choice.wait_for_safer_route.label": "Wait for a safer route",
      "event.conflict_safe_passage_negotiation.title": "Crossing the front line",
      "event.conflict_safe_passage_negotiation.body": "Reaching safe territory means crossing an active conflict zone. An arrangement for safe passage is no guarantee the route stays calm.",
      "event.conflict_ceasefire_calm.title": "A temporary ceasefire",
      "event.conflict_ceasefire_calm.body": "A declared ceasefire allows a return to ordinary life for a while. Markets and schools reopen.",
