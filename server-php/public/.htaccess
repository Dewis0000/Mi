# Боевой сайт: React-статика + PHP-API на /api/

RewriteEngine On

# Пробросить заголовок Authorization в PHP (на части конфигураций reg.ru он
# иначе теряется, и каждый авторизованный запрос возвращает 401).
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteRule .? - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# HTTPS (учёт прокси reg.ru)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Приватные папки/файлы закрыть от веба (на случай, если lib/ и config.php
# лежат внутри корня сайта, а не над ним)
RewriteRule ^(lib|server-php)/ - [F,L]

# API → фронт-контроллер
RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

# SPA: несуществующий путь (не файл, не /api) → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Секреты, SQL и логи — закрыть
<FilesMatch "\.(sql|log)$">
  Require all denied
</FilesMatch>
<Files "config.php">
  Require all denied
</Files>
