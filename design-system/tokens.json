{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "StreOps Design System v1.0. Тёмная тема основная. Группа user — переопределяемые пользователем токены, всё остальное заморожено.",
  "neutral": {
    "$type": "color",
    "0": { "$value": "#000000", "$description": "void: подложка видео" },
    "1": { "$value": "#0A0A0A", "$description": "dark: фон страницы; light: основной текст" },
    "2": { "$value": "#111111", "$description": "dark: поверхность" },
    "3": { "$value": "#171717", "$description": "dark: поднятая поверхность, поля" },
    "4": { "$value": "#1F1F1F", "$description": "dark: оверлей" },
    "5": { "$value": "#2A2A2A", "$description": "dark: разделители" },
    "6": { "$value": "#3A3A3A", "$description": "dark: границы секций" },
    "7": { "$value": "#525252", "$description": "dark: disabled; light: вторичный текст" },
    "8": { "$value": "#6E6E6E", "$description": "рамки контролов (≥3:1); light: приглушённый текст" },
    "9": { "$value": "#8F8F8F", "$description": "dark: приглушённый текст (≥4.5:1)" },
    "10": { "$value": "#B4B4B4", "$description": "dark: вторичный текст; light: disabled" },
    "11": { "$value": "#DCDCDC", "$description": "dark: hover инверсной заливки; light: разделители" },
    "12": { "$value": "#F2F2F2", "$description": "dark: основной текст; light: фон страницы" },
    "13": { "$value": "#FFFFFF", "$description": "dark: primary-заливка, фокус; light: поверхность" }
  },
  "theme": {
    "dark": {
      "$type": "color",
      "bg": {
        "void": { "$value": "{neutral.0}" },
        "page": { "$value": "{neutral.1}" },
        "surface": { "$value": "{neutral.2}" },
        "raised": { "$value": "{neutral.3}" },
        "overlay": { "$value": "{neutral.4}" }
      },
      "state": {
        "hover": { "$value": "rgba(255,255,255,0.04)" },
        "active": { "$value": "rgba(255,255,255,0.08)" },
        "selected": { "$value": "rgba(255,255,255,0.10)" }
      },
      "border": {
        "subtle": { "$value": "{neutral.5}" },
        "default": { "$value": "{neutral.6}" },
        "strong": { "$value": "{neutral.8}" }
      },
      "text": {
        "primary": { "$value": "{neutral.12}" },
        "secondary": { "$value": "{neutral.10}" },
        "muted": { "$value": "{neutral.9}" },
        "disabled": { "$value": "{neutral.7}" },
        "on-inverse": { "$value": "{neutral.1}" }
      },
      "fill-inverse": {
        "default": { "$value": "{neutral.13}" },
        "hover": { "$value": "{neutral.11}" },
        "active": { "$value": "{neutral.10}" }
      },
      "focus": { "color": { "$value": "{neutral.13}" }, "gap": { "$value": "{neutral.1}" } },
      "live": {
        "default": { "$value": "#D92D20" },
        "hover": { "$value": "#C42B1C" },
        "text": { "$value": "#FF6369" },
        "border": { "$value": "rgba(255,99,105,0.40)" },
        "on": { "$value": "#FFFFFF" }
      }
    },
    "light": {
      "$type": "color",
      "bg": {
        "void": { "$value": "{neutral.0}" },
        "page": { "$value": "{neutral.12}" },
        "surface": { "$value": "{neutral.13}" },
        "raised": { "$value": "{neutral.13}" },
        "overlay": { "$value": "{neutral.13}" }
      },
      "state": {
        "hover": { "$value": "rgba(0,0,0,0.04)" },
        "active": { "$value": "rgba(0,0,0,0.07)" },
        "selected": { "$value": "rgba(0,0,0,0.08)" }
      },
      "border": {
        "subtle": { "$value": "{neutral.11}" },
        "default": { "$value": "{neutral.10}" },
        "strong": { "$value": "{neutral.8}" }
      },
      "text": {
        "primary": { "$value": "{neutral.1}" },
        "secondary": { "$value": "{neutral.7}" },
        "muted": { "$value": "{neutral.8}" },
        "disabled": { "$value": "{neutral.10}" },
        "on-inverse": { "$value": "{neutral.12}" }
      },
      "fill-inverse": {
        "default": { "$value": "{neutral.1}" },
        "hover": { "$value": "{neutral.5}" },
        "active": { "$value": "{neutral.6}" }
      },
      "focus": { "color": { "$value": "{neutral.0}" }, "gap": { "$value": "{neutral.12}" } },
      "live": {
        "default": { "$value": "#D92D20" },
        "hover": { "$value": "#B42318" },
        "text": { "$value": "#C42B1C" },
        "border": { "$value": "rgba(196,43,28,0.40)" },
        "on": { "$value": "#FFFFFF" }
      }
    }
  },
  "status": {
    "$description": "Семантика без цвета: рисунок границы + иконка + яркость",
    "success": { "border": { "$value": "1px solid neutral.8" }, "icon": { "$value": "circle-check (заливка)" } },
    "warning": { "border": { "$value": "1px dashed neutral.10" }, "pattern": { "$value": "штриховка 135° 5%" }, "icon": { "$value": "triangle-alert" } },
    "error": { "border": { "$value": "2px solid neutral.12" }, "pattern": { "$value": "штриховка 135° 9%" }, "icon": { "$value": "octagon-x" } },
    "info": { "border": { "$value": "1px solid neutral.6" }, "icon": { "$value": "info" } }
  },
  "glass": {
    "dark": {
      "ambient": { "bg": { "$value": "rgba(255,255,255,0.03)" }, "blur": { "$value": "12px" }, "border": { "$value": "rgba(255,255,255,0.06)" }, "highlight": { "$value": "inset 0 1px 0 rgba(255,255,255,0.04)" } },
      "raised": { "bg": { "$value": "rgba(18,18,18,0.62)" }, "blur": { "$value": "24px" }, "border": { "$value": "rgba(255,255,255,0.10)" }, "highlight": { "$value": "inset 0 1px 0 rgba(255,255,255,0.08)" }, "minOpacity": { "$value": 0.62 } },
      "overlay": { "bg": { "$value": "rgba(14,14,14,0.84)" }, "blur": { "$value": "40px" }, "border": { "$value": "rgba(255,255,255,0.14)" }, "highlight": { "$value": "inset 0 1px 0 rgba(255,255,255,0.12)" }, "minOpacity": { "$value": 0.84 } }
    },
    "light": {
      "ambient": { "bg": { "$value": "rgba(255,255,255,0.45)" }, "blur": { "$value": "12px" }, "border": { "$value": "rgba(0,0,0,0.06)" }, "highlight": { "$value": "inset 0 1px 0 rgba(255,255,255,0.70)" } },
      "raised": { "bg": { "$value": "rgba(255,255,255,0.72)" }, "blur": { "$value": "24px" }, "border": { "$value": "rgba(0,0,0,0.08)" }, "highlight": { "$value": "inset 0 1px 0 rgba(255,255,255,0.90)" }, "minOpacity": { "$value": 0.72 } },
      "overlay": { "bg": { "$value": "rgba(255,255,255,0.90)" }, "blur": { "$value": "40px" }, "border": { "$value": "rgba(0,0,0,0.10)" }, "highlight": { "$value": "inset 0 1px 0 #FFFFFF" }, "minOpacity": { "$value": 0.90 } }
    },
    "grain": { "dark": { "$value": 0.04 }, "light": { "$value": 0.03 } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Onest", "Golos Text", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "SF Mono", "Cascadia Mono", "Consolas", "monospace"] }
    },
    "scale": {
      "$type": "typography",
      "display-2xl": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "72px", "lineHeight": "76px", "letterSpacing": "-0.035em", "fontWeight": 500 } },
      "display-xl": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "52px", "lineHeight": "56px", "letterSpacing": "-0.03em", "fontWeight": 500 } },
      "h1": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "32px", "lineHeight": "38px", "letterSpacing": "-0.02em", "fontWeight": 600 } },
      "h2": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "24px", "lineHeight": "30px", "letterSpacing": "-0.015em", "fontWeight": 600 } },
      "h3": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "lineHeight": "26px", "letterSpacing": "-0.01em", "fontWeight": 600 } },
      "body-l": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "lineHeight": "26px", "letterSpacing": "-0.005em", "fontWeight": 400 } },
      "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0", "fontWeight": 400 } },
      "body-s": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "0.005em", "fontWeight": 400 } },
      "caption": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.01em", "fontWeight": 500 } },
      "overline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "14px", "letterSpacing": "0.08em", "fontWeight": 600, "textTransform": "uppercase" } },
      "mono-display": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "40px", "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": 500 } },
      "mono-l": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "24px", "lineHeight": "28px", "letterSpacing": "-0.01em", "fontWeight": 500 } },
      "mono-m": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0", "fontWeight": 400 } },
      "mono-s": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "lineHeight": "18px", "letterSpacing": "0", "fontWeight": 400 } },
      "mono-xs": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "lineHeight": "14px", "letterSpacing": "0.02em", "fontWeight": 500 } }
    },
    "numeric": { "$value": "tabular-nums", "$description": "Все обновляемые и колоночные числа — font.family.mono + tabular-nums" }
  },
  "space": {
    "$type": "dimension",
    "0.5": { "$value": "2px" }, "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" },
    "4": { "$value": "16px" }, "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" },
    "10": { "$value": "40px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" },
    "24": { "$value": "96px" }, "32": { "$value": "128px" }
  },
  "container": {
    "$type": "dimension",
    "prose": { "$value": "680px" }, "form": { "$value": "880px" }, "page": { "$value": "1280px" }, "wide": { "$value": "1440px" }
  },
  "breakpoint": {
    "base": { "min": { "$value": "0px" }, "columns": { "$value": 4 }, "gutter": { "$value": "16px" }, "margin": { "$value": "16px" } },
    "sm": { "min": { "$value": "640px" }, "columns": { "$value": 8 }, "gutter": { "$value": "20px" }, "margin": { "$value": "24px" } },
    "lg": { "min": { "$value": "1024px" }, "columns": { "$value": 12 }, "gutter": { "$value": "24px" }, "margin": { "$value": "32px" } },
    "xl": { "min": { "$value": "1280px" }, "columns": { "$value": 12 }, "gutter": { "$value": "24px" }, "margin": { "$value": "40px" } },
    "2xl": { "min": { "$value": "1536px" }, "columns": { "$value": 12 }, "gutter": { "$value": "32px" }, "margin": { "$value": "48px" } }
  },
  "radius": {
    "$type": "dimension",
    "0": { "$value": "0px" }, "xs": { "$value": "2px" }, "sm": { "$value": "4px" }, "md": { "$value": "6px" },
    "lg": { "$value": "8px" }, "xl": { "$value": "12px" }, "full": { "$value": "9999px" }
  },
  "borderWidth": { "$type": "dimension", "1": { "$value": "1px" }, "2": { "$value": "2px" } },
  "shadow": {
    "dark": {
      "1": { "$value": "0 1px 2px rgba(0,0,0,0.50)" }, "2": { "$value": "0 4px 12px -2px rgba(0,0,0,0.50)" },
      "3": { "$value": "0 12px 32px -8px rgba(0,0,0,0.60)" }, "4": { "$value": "0 32px 80px -16px rgba(0,0,0,0.75)" }
    },
    "light": {
      "1": { "$value": "0 1px 2px rgba(0,0,0,0.06)" }, "2": { "$value": "0 4px 12px -2px rgba(0,0,0,0.08)" },
      "3": { "$value": "0 12px 32px -8px rgba(0,0,0,0.12)" }, "4": { "$value": "0 32px 80px -16px rgba(0,0,0,0.18)" }
    }
  },
  "icon": {
    "set": { "$value": "lucide-react" }, "stroke": { "$value": 1.5 }, "absoluteStrokeWidth": { "$value": true },
    "size": { "xs": { "$value": "14px" }, "sm": { "$value": "16px" }, "md": { "$value": "20px" }, "lg": { "$value": "24px" }, "xl": { "$value": "40px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "0ms" }, "fast": { "$value": "80ms" }, "quick": { "$value": "120ms" }, "base": { "$value": "180ms" },
      "moderate": { "$value": "240ms" }, "slow": { "$value": "320ms" }, "deliberate": { "$value": "480ms" },
      "shimmer": { "$value": "1600ms" }, "pulse": { "$value": "2000ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }, "enter": { "$value": [0.16, 1, 0.3, 1] }, "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "spring": { "snap": { "$value": { "stiffness": 520, "damping": 42 } } },
    "exitRatio": { "$value": 0.7 }
  },
  "z": {
    "$type": "number",
    "decor": { "$value": -1 }, "base": { "$value": 0 }, "raised": { "$value": 10 }, "sticky": { "$value": 100 },
    "header": { "$value": 200 }, "dropdown": { "$value": 300 }, "drawer": { "$value": 400 }, "modal": { "$value": 500 },
    "toast": { "$value": 600 }, "tooltip": { "$value": 700 }, "skiplink": { "$value": 900 }
  },
  "user": {
    "$description": "Переопределяемые токены. Значения — по умолчанию (пресет «Графит»), с границами.",
    "theme": { "$value": "dark", "options": ["dark", "light"] },
    "bg-color": { "$type": "color", "$value": "#0A0A0A", "constraint": "dark: OKLCH L ≤ 0.24; light: L ≥ 0.92" },
    "bg-image": { "$value": null, "constraint": "JPG/PNG/WebP ≤ 8 МБ → WebP 2560px" },
    "bg-blur": { "$type": "dimension", "$value": "0px", "min": "0px", "max": "40px", "step": "2px" },
    "bg-dim": { "$value": 0, "min": "auto (dimMin)", "max": 0.9 },
    "gradient": { "$value": null, "constraint": "2 цвета + угол, OKLCH C ≤ 0.15" },
    "tint": { "$type": "color", "$value": null, "constraint": "только декор и подложка стекла, ≤ 6%" },
    "effect": { "$value": "none", "options": ["none", "stars", "vignette", "grain-plus"] },
    "glass-boost": { "$value": 0, "min": 0, "max": 0.2 }
  },
  "presets": {
    "graphite": { "name": "Графит", "theme": "dark", "bg-color": "#0A0A0A", "effect": "none", "grain": 0.04 },
    "midnight": { "name": "Полночь", "theme": "dark", "bg-color": "#000000", "effect": "stars", "effect-density": 40, "grain": 0.03 },
    "paper": { "name": "Бумага", "theme": "light", "bg-color": "#F2F2F2", "effect": "none", "grain": 0.03 },
    "fog": { "name": "Туман", "theme": "dark", "bg-image": "user", "bg-blur": "24px", "bg-dim": "auto", "tint": "#6F7F75", "glass-boost": 0.08 }
  }
}
