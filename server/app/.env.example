# StreOps — настройки сервера. Скопируй в .env (рядом с этим файлом) и заполни.
# Этот файл НЕ должен попадать в git и в папку сайта.

APP_URL=https://streops.ru
ADMIN_LOGIN=zaka_00

# База MySQL (из панели reg.ru)
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=u3661097_default
DB_USER=u3661097_default
DB_PASS=

# Приложение Twitch (dev.twitch.tv/console): Client ID и Client Secret
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Аккаунт бота
BOT_LOGIN=streopsbot
# Запасной токен бота (например, с twitchtokengenerator): бот сможет писать и модерировать
# ещё до подключения через админ-панель. Можно оставить пустым.
BOT_ACCESS_TOKEN=

# Секрет для подписи событий Twitch: любая длинная случайная строка (10–100 символов)
EVENTSUB_SECRET=

# YouTube Data API v3 — для заказа музыки
YOUTUBE_API_KEY=

# DonationAlerts OAuth-приложение (donationalerts.com/application/clients) — для донатов в виджетах
DA_CLIENT_ID=
DA_CLIENT_SECRET=

# FACEIT Data API (developers.faceit.com) — для виджетов FACEIT. Необязательно.
FACEIT_API_KEY=
