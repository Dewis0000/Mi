# --- Основное ---
NODE_ENV=development
PORT=4000
TZ=Europe/Moscow
# Адрес фронтенда (CORS, ссылки в уведомлениях)
APP_URL=http://localhost:5173
# Публичный адрес API (ссылки на скачивание)
API_URL=http://localhost:4000

DATABASE_URL=postgresql://quest:quest@localhost:5432/quest?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access
# Секрет для подписи временных ссылок и токенов трансляций
SIGNING_SECRET=change-me-signing

# --- Подтверждение телефона ---
# В режиме development код возвращается в ответе API и пишется в лог
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
VK_GROUP_TOKEN=
MAX_BOT_TOKEN=
# Telegram-чат администраторов для уведомлений о новых заявках
ADMIN_TELEGRAM_CHAT_ID=

# --- Невидимая капча (Яндекс SmartCaptcha) ---
SMARTCAPTCHA_SERVER_KEY=

# --- Оплата: mock | yookassa ---
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Хранилище видео: local | s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=quest-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Трансляции (MediaMTX) ---
# Базовый адрес HLS-сервера; поток комнаты N: {MEDIA_HLS_URL}/room{N}/index.m3u8
MEDIA_HLS_URL=http://localhost:8888
# Control API MediaMTX (включение записи на время сеанса). Пусто — не управлять записью
MEDIA_API_URL=
# Секрет, с которым медиасервер / камеры вызывают /api/recordings/ingest
INGEST_SECRET=change-me-ingest

# --- Сид ---
# Телефон главного администратора, создаваемого сидом
SEED_OWNER_PHONE=+79990000001
SEED_OWNER_PASSWORD=admin12345
