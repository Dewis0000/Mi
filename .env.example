# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не коммитится в git — см. .gitignore.

# --- База данных ---
# Локально: postgresql://quest_app:<пароль>@localhost:5432/quest_club
# На reg.ru: строка подключения к PostgreSQL на вашем VDS (см. docs/ARCHITECTURE.md, раздел 16)
DATABASE_URL="postgresql://user:password@localhost:5432/quest_club"

# --- Авторизация (next-auth) ---
# Случайная строка не короче 32 байт: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
NEXTAUTH_URL="http://localhost:3000"
# Нужно для работы за реверс-прокси (Nginx на reg.ru и т.п.)
AUTH_TRUST_HOST=true

# Публичный адрес сайта — используется для ссылок в письмах/SMS и возврата после оплаты
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Вход через VK ID ---
# Получить: https://id.vk.com/business/go, зарегистрировать приложение
AUTH_VK_ID=""
AUTH_VK_SECRET=""

# --- Вход через Яндекс ID ---
# Получить: https://oauth.yandex.ru/
AUTH_YANDEX_ID=""
AUTH_YANDEX_SECRET=""

# --- Вход через Telegram ---
# Создать бота у @BotFather, затем /setdomain с публичным доменом сайта
# (на localhost виджет Telegram не отрисуется — нужен публичный домен)
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# MAX (национальный мессенджер) — на момент разработки нет стабильного публичного
# OAuth-эндпоинта; подключается по аналогии с VK/Яндекс, когда появится документация.
# См. docs/ARCHITECTURE.md, разделы 3 и 15.

# --- Оплата ---
# "mock" — тестовый режим без реального эквайринга (по умолчанию).
# "yookassa" — включает ЮKassa, если заданы ключи ниже.
PAYMENT_PROVIDER="mock"

# ЮKassa: https://yookassa.ru/developers/api — личный кабинет → Интеграция → Ключи API
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
